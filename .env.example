# Blond Beauty Engine — example environment variables.
# Copy to `.env` and fill in real values for local development.
# NEVER commit `.env`. NEVER put production credentials here.

# Operational
# Fake providers are refused when ENGINE_ENV is prod/production.
ENGINE_ENV=dev
ENGINE_SERVICE_NAME=blond-beauty-engine
ENGINE_LOG_LEVEL=info
ENGINE_HTTP_ADDR=:8081
ENGINE_SHUTDOWN_TIMEOUT=30s

# Postgres (shared with the API; Engine treats schema as a contract)
ENGINE_POSTGRES_URL=postgres://engine:engine@localhost:5432/blondbeauty?sslmode=disable
ENGINE_POSTGRES_MAX_CONNS=10

# RabbitMQ
ENGINE_RABBIT_URL=amqp://guest:guest@localhost:5672/
ENGINE_RABBIT_PREFETCH=32

# Redis (optional in Slice A; leave empty to disable)
ENGINE_REDIS_URL=

# Slice A demo flag — remove once real workers are wired.
ENGINE_ENABLE_FAKE_WORKER=true

# Slice B+C: payments workers (create / confirm / capture / cancel / refund / reconcile / webhook).
# Ships the "fake" provider only; real Getnet/Stripe/etc adapters land later.
ENGINE_ENABLE_PAYMENTS_WORKERS=true
ENGINE_PAYMENTS_CONCURRENCY=4

# Slice D: transactional email worker (emails.transactional queue).
# Ships the "fake-email" provider only; real SMTP/SES/Resend adapters land later.
ENGINE_ENABLE_EMAIL_WORKERS=true
ENGINE_EMAILS_CONCURRENCY=4

# Slice E: fiscal / NF-e workers (fiscal.issue, fiscal.retry, fiscal.cancel queues).
# Ships the "fake-fiscal" provider only. Real SEFAZ integration requires
# review by a qualified Brazilian accountant before implementation.
ENGINE_ENABLE_FISCAL_WORKERS=true
ENGINE_FISCAL_CONCURRENCY=2

# Slice F: fulfillment worker (orders.fulfillment queue).
# Ships the "fake-fulfillment" provider only. No real carrier/3PL integration.
ENGINE_ENABLE_FULFILLMENT_WORKERS=true
ENGINE_FULFILLMENT_CONCURRENCY=4
